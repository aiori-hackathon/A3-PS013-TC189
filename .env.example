APP_NAME=CyberTrace
ENVIRONMENT=development
API_PREFIX=/api
LOG_LEVEL=INFO

# Use a dedicated least-privilege PostgreSQL role. Replace every placeholder.
DATABASE_URL=postgresql+psycopg://cybertrace_app:CHANGE_ME@localhost:5432/cybertrace
TEST_DATABASE_URL=postgresql+psycopg://cybertrace_app:CHANGE_ME@localhost:5432/cybertrace_test

# ---------------------------------------------------------------- Docker setup
# Used together with docker-compose.yml (copy this file to .env first).
#
# `docker compose` creates the PostgreSQL container with the credentials
# below and assembles the backend DATABASE_URL automatically; the localhost
# DATABASE_URL above is overridden inside Compose and stays only for
# non-Docker local development. Keep POSTGRES_PASSWORD URL-safe (letters,
# digits, "_" and "-"; avoid "@", ":" and other reserved URL characters).
# POSTGRES_HOST=db is the Compose service name used by the backend container.
POSTGRES_DB=cybertrace
POSTGRES_USER=cybertrace_app
POSTGRES_PASSWORD=CHANGE_ME_long_database_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Host port for the API and dashboards (container listens on 8000 internally).
APP_PORT=8000
# ---------------------------------------------------------------------------

# Relative paths are resolved from the project root.
STORAGE_ROOT=backend/storage
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_LINE_BYTES=1048576
MAX_STORED_RAW_LINE_CHARS=8000
MAX_PARSING_ISSUES=10000
ALLOWED_EXTENSIONS=.log,.txt,.auth,.access,.out,.audit
CORS_ORIGINS=

# Phase 2 endpoint agents. Generate a long random enrollment token, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Registration is disabled while this is empty. Agent bearer tokens are generated
# by the server and stored only as SHA-256 hashes.
AGENT_ENROLLMENT_TOKEN=
AGENT_STALE_AFTER_SECONDS=300
AGENT_BATCH_MAX_FILES=50
AGENT_BATCH_MAX_BYTES=52428800
AGENT_MANIFEST_MAX_BYTES=524288

# Phase 3 evidence quality. Coverage and gap views default to this lookback window
# when the API caller does not supply explicit start/end timestamps.
QUALITY_DEFAULT_WINDOW_HOURS=24
